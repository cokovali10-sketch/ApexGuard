# EditorConfig — https://editorconfig.org

root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{go}]
indent_style = tab
indent_size = 4

[*.{py}]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,json,css,html}]
indent_style = space
indent_size = 2

[*.{c,h,rs,proto}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
