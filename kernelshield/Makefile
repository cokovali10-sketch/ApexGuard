# KernelShield — CO-RE eBPF build system.
# Targets:
#   make all          -> vmlinux.h + kernelshield.bpf.o (готов к install)
#   make skel         -> C-skeleton (kernelshield.skel.h)
#   make docker-build -> сборка в изолированном контейнере
#   make install      -> установка в /opt/apexguard/kernelshield
#   make clean
#
# Для CO-RE необходим BTF vmlinux. Если /sys/kernel/btf/vmlinux недоступен
# (CI/кросс-сборка), передайте VMLINUX_BTF=/path/to/vmlinux.btf либо
# положите готовый include/vmlinux.h (например, с BTFHub).

CC          ?= clang
LLVM_STRIP  ?= llvm-strip
BPFTOOL     ?= bpftool
ARCH        := $(shell uname -m | sed 's/x86_64/x86/g' | sed 's/aarch64/arm64/g')

VMLINUX_H   := include/vmlinux.h
VMLINUX_BTF ?= /sys/kernel/btf/vmlinux

BPF_C       := probes/kernelshield.bpf.c
BPF_O       := kernelshield.bpf.o
SKEL_C      := kernelshield.skel.h
SKEL_RS_OUT := agent/src/bpf/kernelshield.skel.rs

BPF_CFLAGS  := -g -O2 -target bpf -D__TARGET_ARCH_$(ARCH) \
               -Wall -Werror -Wunused-variable -Wno-unused-function \
               -D__KERNEL__ -D__TASK_COMM_LEN=16 \
               -I. -Iinclude \
               -I/usr/include/$(shell uname -m)-linux-gnu \
               -I/usr/local/include

ALL_CFLAGS  := $(BPF_CFLAGS)

.PHONY: all skel install docker-build clean help

help:
	@echo "Targets: all | skel | install | docker-build | clean"
	@echo "Env: VMLINUX_BTF=/path/vmlinux.btf  (override BTF source)"

# ---------------------------------------------------------------------------
# vmlinux.h — генерация из BTF (kernel 5.2+, CONFIG_DEBUG_INFO_BTF)
# ---------------------------------------------------------------------------
$(VMLINUX_H):
	@if [ -f "$(VMLINUX_BTF)" ]; then \
		echo ">>> dumping vmlinux.h from $(VMLINUX_BTF)"; \
		$(BPFTOOL) btf dump file $(VMLINUX_BTF) format c > $@; \
	elif [ -f "$(CURDIR)/include/vmlinux.h.bundled" ]; then \
		echo ">>> using bundled vmlinux.h"; \
		cp include/vmlinux.h.bundled $@; \
	else \
		echo "ERROR: no BTF at $(VMLINUX_BTF) and no bundled header"; \
		echo "  Provide: make VMLINUX_BTF=./vmlinux.btf"; \
		exit 1; \
	fi

# ---------------------------------------------------------------------------
# Сборка BPF-объекта
# ---------------------------------------------------------------------------
$(BPF_O): $(BPF_C) $(VMLINUX_H)
	$(CC) $(ALL_CFLAGS) -c $(BPF_C) -o $@
	$(LLVM_STRIP) -g $@
	@echo ">>> BPF object: $@"
	@$(BPFTOOL) gen skeleton $@ 2>/dev/null > /dev/null && echo ">>> skeleton generation OK"

all: $(BPF_O)

# C-скелет для классического libbpf C-агента
skel: $(BPF_O)
	$(BPFTOOL) gen skeleton $(BPF_O) name kernelshield > $(SKEL_C)
	@echo ">>> $(SKEL_C)"

# ---------------------------------------------------------------------------
# Rust-агент: генерация kernelshield.skel.rs из .bpf.o
# (build.rs агента умеет делать это сам; цель — явный контроль версии)
# ---------------------------------------------------------------------------
$(SKEL_RS_OUT): $(BPF_O)
	mkdir -p $(dir $@)
	$(BPFTOOL) gen skeleton $(BPF_O) name kernelshield > /tmp/ks.skel.h
	@echo ">>> sketch: $(SKEL_RS_OUT) generated by agent/build.rs at cargo build time"

# ---------------------------------------------------------------------------
# Сборка в изолированном Docker-контейнере (воспроизводимо, без хост-BTF)
# ---------------------------------------------------------------------------
docker-build:
	docker build \
		--build-arg VMLINUX_BTF=/sys/kernel/btf/vmlinux \
		-t apexguard/kernelshield-builder:latest \
		-f build/Dockerfile .
	docker run --rm \
		-v "$(CURDIR)":/src \
		--privileged \
		apexguard/kernelshield-builder:latest \
		make VMLINUX_BTF=/sys/kernel/btf/vmlinux all

install: $(BPF_O)
	install -d $(DESTDIR)/opt/apexguard/kernelshield
	install -m 0644 $(BPF_O) $(DESTDIR)/opt/apexguard/kernelshield/
	install -m 0644 include/vmlinux.h $(DESTDIR)/opt/apexguard/kernelshield/ || true
	@echo ">>> installed to $(DESTDIR)/opt/apexguard/kernelshield"

clean:
	rm -f $(BPF_O) $(SKEL_C)
	rm -f agent/src/bpf/kernelshield.skel.rs
	rm -rf __pycache__
	@echo "cleaned"
